NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGINS=*

MONGODB_URI=mongodb://admin:change-me@localhost:27017/?authSource=admin
MONGODB_DB=datashelf

RABBITMQ_URL=amqp://guest:change-me@localhost:5672
RABBITMQ_EXCHANGE=datashelf.events
RABBITMQ_QUEUE=datashelf.api.charts-computed
RABBITMQ_PREFETCH=10

S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=datashelf
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_RAW_PREFIX=raw-data
UPLOAD_MAX_SIZE_MB=10

AIRFLOW_URL=http://localhost:8080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=change-me
AIRFLOW_DAG_ID=customer_data_etl
