# Local development values (MinIO + RabbitMQ from docker compose). Copy to .env and adjust.
S3_ENDPOINT=http://minio:9000
S3_REGION=ru-central1
S3_BUCKET=datashelf
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_RAW_PREFIX=raw-data
S3_STAGING_PREFIX=staging

RABBITMQ_URL=amqp://guest:change-me@rabbitmq:5672/
RABBITMQ_EXCHANGE=datashelf.events
