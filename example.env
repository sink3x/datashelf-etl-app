# Local development defaults for docker compose.
# `make env` copies this file to .env; the Makefile falls back to it when .env is absent.
# Every value here is a throwaway local credential — never put real secrets in this file.

# --- API ---
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
UPLOAD_MAX_SIZE_MB=10

# --- MongoDB ---
MONGODB_USER=datashelf
MONGODB_PASSWORD=datashelf-local
MONGODB_DB=datashelf

# --- RabbitMQ ---
RABBITMQ_USER=datashelf
RABBITMQ_PASSWORD=datashelf-local
RABBITMQ_EXCHANGE=datashelf.events
RABBITMQ_QUEUE=datashelf.api.charts-computed
RABBITMQ_PREFETCH=10

# --- Object storage (RustFS locally, Yandex Object Storage in the cloud) ---
S3_REGION=us-east-1
S3_BUCKET=datashelf
S3_ACCESS_KEY_ID=datashelf
S3_SECRET_ACCESS_KEY=datashelf-local-secret
S3_RAW_PREFIX=raw-data
S3_STAGING_PREFIX=staging

# --- Airflow ---
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin-local
AIRFLOW_DAG_ID=customer_data_etl
POSTGRES_PASSWORD=airflow-local
AIRFLOW_JWT_SECRET=local-jwt-secret-change-me
AIRFLOW_API_SECRET=local-api-secret-change-me
# Throwaway Fernet key for local use only.
AIRFLOW_FERNET_KEY=ZmRhdGFzaGVsZi1sb2NhbC1mZXJuZXQta2V5LTAwMDA=

# --- Host ports (change when a port is already taken on your machine) ---
WEB_HOST_PORT=3000
API_HOST_PORT=5000
AIRFLOW_HOST_PORT=8080
MONGODB_HOST_PORT=27017
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
S3_HOST_PORT=9000
S3_UI_HOST_PORT=9001
