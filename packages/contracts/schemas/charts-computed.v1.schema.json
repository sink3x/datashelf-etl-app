{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sink3x/datashelf-etl-app/packages/contracts/schemas/charts-computed.v1.schema.json",
  "title": "ChartsComputedEvent",
  "description": "Published by an ETL analytics task once it has computed one or more charts for an uploaded dataset. Consumers must treat (run_id, job) as the idempotency key.",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "run_id",
    "job",
    "dataset",
    "processing_time_sec",
    "meta",
    "charts"
  ],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "dataset.charts.computed" },
    "schema_version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 250 },
    "job": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
    "dataset": {
      "type": "object",
      "required": ["object_key", "filename"],
      "additionalProperties": false,
      "properties": {
        "object_key": { "type": "string", "minLength": 1 },
        "filename": { "type": "string", "minLength": 1 }
      }
    },
    "processing_time_sec": { "type": "number", "minimum": 0 },
    "meta": { "type": "object" },
    "charts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/chart" }
    }
  },
  "$defs": {
    "top": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": ["string", "null"] }
      }
    },
    "base": {
      "type": "object",
      "required": ["name", "title", "description", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "series": {
      "required": ["labels", "values"],
      "properties": {
        "type": { "enum": ["line", "bar", "pie", "area"] },
        "labels": { "type": "array", "items": { "type": "string" } },
        "values": { "type": "array", "items": { "type": "number" } }
      }
    },
    "frequency": {
      "required": ["labels", "values", "total", "top"],
      "properties": {
        "type": { "const": "frequency" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "values": { "type": "array", "items": { "type": "number" } },
        "total": { "type": "number" },
        "top": { "$ref": "#/$defs/top" }
      }
    },
    "grouped": {
      "required": ["labels", "values_sum", "values_count", "top"],
      "properties": {
        "type": { "const": "grouped" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "values_sum": { "type": "array", "items": { "type": "number" } },
        "values_count": { "type": "array", "items": { "type": "number" } },
        "top": { "$ref": "#/$defs/top" }
      }
    },
    "metric": {
      "required": ["value"],
      "properties": {
        "type": { "const": "metric" },
        "value": { "type": ["number", "string"] },
        "unit_sign": { "type": "string" }
      }
    },
    "chart": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "oneOf": [
        { "$ref": "#/$defs/series" },
        { "$ref": "#/$defs/frequency" },
        { "$ref": "#/$defs/grouped" },
        { "$ref": "#/$defs/metric" }
      ]
    }
  }
}
